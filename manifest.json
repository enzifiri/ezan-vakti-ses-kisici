{
  "manifest_version": 3,
  "name": "Ezan Vakti Ses Kapatıcı – Ezanda müziği otomatik kapar",
  "version": "1.0.3",
  "description": "Ezan vaktinde tarayıcıdaki müziği yumuşakça kısar, ezan bitince geri açar. Diyanet vakitleri, hesap gerekmez.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://ezanvakti.emushaf.net/*",
    "https://ezanvakti.imsakiyem.com/*",
    "https://namazvakti.mtopal.dev/*",
    "https://*.youtube.com/*",
    "https://open.spotify.com/*",
    "https://soundcloud.com/*",
    "https://music.apple.com/*",
    "https://*.deezer.com/*",
    "https://fizy.com/*",
    "https://muud.com.tr/*",
    "https://music.amazon.com.tr/*",
    "https://music.amazon.com/*",
    "https://listen.tidal.com/*",
    "https://www.twitch.tv/*",
    "https://kick.com/*",
    "https://www.netflix.com/*",
    "https://www.primevideo.com/*",
    "https://www.disneyplus.com/*",
    "https://*.puhutv.com/*",
    "https://*.exxen.com/*",
    "https://*.tabii.com/*",
    "https://*.hbomax.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Ezan Vakti Ses Kapatıcı",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
