{
  "manifest_version": 3,
  "name": "Ezan Vakti Ses Kısıcı – Ezanda müziği otomatik kısar",
  "version": "1.0.0",
  "description": "Ezan vaktinde tarayıcıdaki müziği yumuşakça kısar, ezan bitince geri açar. Diyanet vakitleri, hesap gerekmez.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Ezan Vakti Ses Kısıcı",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
